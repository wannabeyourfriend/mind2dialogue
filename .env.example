# Mind2Dialogue — environment variables (rename to .env and fill in)
# All entry scripts read these; .env is gitignored.

# OpenAI-compatible LLM endpoint. Works with vLLM, OpenAI, Anthropic-via-gateway, …
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Simulator and Oracle backbone used in the paper.
MODEL_NAME=gpt-4o-mini

# Optional model overrides on the same endpoint. SIM_MODEL controls both
# the user simulator and Oracle. JUDGE_MODEL controls quality-check judges.
# SIM_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4.1-mini
